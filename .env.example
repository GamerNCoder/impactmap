# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Social sign-in (optional). Comma-separated list of providers to show on the
# login page: google, apple, azure. Leave empty to hide social sign-in entirely
# (email + password always works). Each provider must also be enabled in
# Supabase → Authentication → Providers.
NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=

# Live demo accounts (server-only). /demo signs in with these; leave both passwords
# empty to hide the demo. Passwords are generated by deploy.sh and kept in
# .env.deploy.local — never commit them.
NEXT_PUBLIC_DEMO_ENABLED=false
DEMO_STUDENT_EMAIL=demo.student@impactmap.app
DEMO_STUDENT_PASSWORD=
DEMO_ORGANIZER_EMAIL=demo.organizer@impactmap.app
DEMO_ORGANIZER_PASSWORD=
